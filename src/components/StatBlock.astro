---
// Renders an entity's `mechanics` as a labelled definition list, in the
// field order declared for its type (webgen/taxonomy.json), with Spanish
// labels. Rating-like fields render as dot pips; sphere maps render one
// dot-rating per sphere; everything else renders as plain text.
import DotRating from './DotRating.astro';
import { mechanicLabelEs, sphereLabelEs, TYPE_INFO } from '../lib/taxonomy';
import { allocationNoteEs, axisFieldKey, isRatingRows, ratedAxes } from '../lib/ratedAxes';
import { sharedScaleLookup } from '../lib/sharedScales';

export interface Props {
  type: string;
  mechanics: Record<string, unknown>;
  // Pre-rendered HTML (with deep-links) for string/list mechanics values; keyed
  // by mechanic. Present only where an entity link was injected.
  mechanicsHtml?: Record<string, string | string[]>;
}
const { type, mechanics, mechanicsHtml = {} } = Astro.props;

// Fields rendered as dot ratings when their value is a plain number.
const DOT_FIELDS = new Set([
  'cost',
  'bonus',
  'rating_max',
  'arete_min',
  'arete',
  'quintessence',
  'level',
  'rank',
]);

function toSphereEntries(value: unknown): Array<[string, number]> {
  if (!value || typeof value !== 'object' || Array.isArray(value)) return [];
  return Object.entries(value as Record<string, number>);
}

const knownFields = TYPE_INFO[type]?.mechanical_fields ?? [];
// Show declared fields plus any extra keys, but hide internal `_`-prefixed
// extraction-metadata keys (e.g. `_extraction_note`) — not player-facing.
const extraFields = Object.keys(mechanics).filter(
  (key) => !knownFields.includes(key) && !key.startsWith('_')
);
const presentFields = [...knownFields, ...extraFields].filter(
  (key) => mechanics[key] !== undefined && mechanics[key] !== null
);

const cell = (v: unknown): string =>
  v === null || v === undefined ? '' : typeof v === 'object' ? JSON.stringify(v) : String(v);

function isObjectArray(v: unknown): v is Array<Record<string, unknown>> {
  return (
    Array.isArray(v) &&
    v.length > 0 &&
    v.every((x) => x !== null && typeof x === 'object' && !Array.isArray(x))
  );
}

// One rendered table. `caption` is '' for every table the site emitted before `mechanics.scales`
// existed (an extracted rules table, and the single unnamed ladder of a `mechanics.ratings`
// carrier); it carries the axis name only for a multi-scale trait, where three anonymous tables
// would be unreadable.
interface MechTable {
  caption: string;
  rows: Array<Record<string, unknown>>;
  columns: string[];
}

// One rendered rated axis: a ladder TABLE, or — for an axis the book states as a formula and
// prints no rungs for — the FORMULA sentence under the same caption. Exactly one of the two is
// set. Mirrors `models.mech_block()`, which emits the `<h5 class='wod-kb-scale'>` heading either
// way and then `ratings_table()` **or** a `<p class='wod-kb-formula'>`.
interface Ladder {
  caption: string;
  table?: MechTable;
  formula?: string;
}

interface Field {
  key: string;
  label: string;
  sphereEntries: Array<[string, number]>;
  numericValue?: number;
  // array-of-objects → one table; a multi-scale trait → one entry per RENDERED axis, which is a
  // table for a tabulated scale and a formula sentence for one the book states as prose.
  ladders?: Ladder[];
  note?: string; // how points are spent across a multi-scale trait's axes
  arrayValue?: unknown[]; // array of primitives → comma list
  objectValue?: Array<[string, unknown]>; // single object → key/value list
  textValue?: string;
  html?: string | string[]; // pre-rendered HTML (deep-links) for text/array values
}

const withColumns = (caption: string, rows: Array<Record<string, unknown>>): MechTable => ({
  caption,
  rows,
  columns: [...new Set(rows.flatMap((r) => Object.keys(r)))],
});

// The entity's rated axes, resolved ONCE through the shared definition rather than re-derived per
// field. A `mechanics.ratings` carrier yields the single degenerate axis (empty `name_es` → no
// caption, no note), so its markup is exactly what it was before `scales` existed; a
// `mechanics.scales` carrier yields one named axis per scale.
// A `ref` scale carries no rows of its own — the cited `aspect` entity does — so the axes are
// resolved through the shared index before anything is counted or drawn. Without this the ref axis
// came back rowless and was filtered out entirely: `mage/hedge-path/curacion` drew nothing for its
// one cited Aspect, `sombras` drew 1 of 5, and the note below still counted all five.
const resolveSharedScale = await sharedScaleLookup();
const axes = ratedAxes(mechanics, resolveSharedScale);
const ladderKey = axisFieldKey(mechanics);
// A formula axis (`mage/aspect/dano-curacion`: "Por cada nivel de este Aspecto…") is not a defect
// and not a table — the book prints a sentence and no rungs, so five invented rows would be
// authoring what the page does not say. It renders as prose under its own caption. An axis with
// NEITHER rows nor prose is an unresolved `ref`: it draws nothing, and `allocationNoteEs()` (which
// applies the same `axisRenders` predicate) does not count it either, so the note can never
// promise a scale the page did not draw.
const ladders: Ladder[] = axes.flatMap((axis): Ladder[] => {
  if (isRatingRows(axis.ratings)) return [{ caption: axis.name_es, table: withColumns(axis.name_es, axis.ratings) }];
  if (axis.body_es) return [{ caption: axis.name_es, formula: axis.body_es }];
  return [];
});
const ladderNote = ladderKey === 'scales' ? allocationNoteEs(axes, mechanics.rating_max as number | undefined) : '';
// THE LADDER FIELD IS RENDERED BY THE LADDER BRANCH OR NOT AT ALL. Every other branch below is
// wrong for it, and the generic array-of-objects branch is catastrophically so: `mechanics.scales`
// IS an array of objects, so a scales list that reaches it renders as a
// `key | name_es | ref | allocation` table — a serialized view of the data model, which
// `web-presentation`'s first requirement names as "worse than the present blank".
// It was reachable: the old test was `ladders.length > 0`, and an entity ALL of whose scales are
// unresolved `ref`s (`mage/hedge-path/curacion` cites one shared Aspect and nothing else) produces
// zero ladders and fell straight through. Measured on the shipped tree with the refs deliberately
// broken: `curacion` rendered exactly that table. Dropping the key instead mirrors
// `models.mech_block()`, which `continue`s past `ratings`/`scales` unconditionally and then emits
// only the tables it has. Nothing is lost by it: 0 records in the tree carry a `ratings` list whose
// rows are not objects, so "the ladder key renders no ladder" means there was nothing to show.
const fieldKeys = presentFields.filter((key) => key !== ladderKey || ladders.length > 0);

const fields: Field[] = fieldKeys.map((key) => {
  const value = mechanics[key];
  // Only treat `spheres` as a dot-pip map when it's actually an object
  // ({Vida: 3}). Lane-B often writes it as a free-text string ("Correspondencia
  // ·· / Fuerzas ·· / Mente ··"); those must fall through to textValue, else the
  // Esferas field renders blank.
  const sphereEntries = key === 'spheres' ? toSphereEntries(value) : [];
  const isSphereMap = sphereEntries.length > 0;
  const numericValue = !isSphereMap && DOT_FIELDS.has(key) && typeof value === 'number' ? value : undefined;
  // The rating ladder(s). One table for a `ratings` carrier — the same markup, from the same
  // renderer, as before — and one captioned table per axis for a `scales` carrier, whose value is
  // an array of SCALE objects and would otherwise land in the generic branch below as a table of
  // `key | name_es | rating_max | allocation | ratings` with five rung objects JSON-stringified
  // into one cell.
  // `fieldKeys` has already dropped the ladder key when it renders nothing, so this is exactly
  // "is this the rated-axis field", and the branches below can never see `ratings`/`scales`.
  const isLadder = key === ladderKey;
  // Array of objects (e.g. an extracted rules table) → render as a real table,
  // never `[object Object]`. Columns are the union of keys across rows.
  const generic = !isLadder && !isSphereMap && numericValue === undefined && isObjectArray(value) ? value : undefined;
  const fieldLadders = isLadder ? ladders : generic ? [{ caption: '', table: withColumns('', generic) }] : undefined;
  const note = isLadder && ladderNote ? ladderNote : undefined;
  const arrayValue =
    !isSphereMap && numericValue === undefined && !fieldLadders && Array.isArray(value) ? value : undefined;
  const objectValue =
    !isSphereMap && numericValue === undefined && !fieldLadders && !arrayValue && value && typeof value === 'object'
      ? Object.entries(value as Record<string, unknown>)
      : undefined;
  const textValue =
    !isSphereMap && numericValue === undefined && !fieldLadders && !arrayValue && !objectValue
      ? String(value)
      : undefined;
  const html = mechanicsHtml[key]; // pre-rendered HTML with deep-links, if any
  return { key, label: mechanicLabelEs(key), sphereEntries, numericValue, ladders: fieldLadders, note, arrayValue, objectValue, textValue, html };
});
---

{
  fields.length > 0 && (
    <dl class="stat-block">
      {fields.map((field) => (
        <>
          <dt>{field.label}</dt>
          <dd>
            {field.sphereEntries.length > 0 && (
              <ul class="spheres">
                {field.sphereEntries.map(([sphere, dots]) => (
                  <li>
                    {sphereLabelEs(sphere)} <DotRating value={dots} label={sphereLabelEs(sphere)} />
                  </li>
                ))}
              </ul>
            )}
            {field.numericValue !== undefined && (
              <DotRating value={field.numericValue} label={field.label} />
            )}
            {field.note && <p class="alloc-note">{field.note}</p>}
            {field.ladders &&
              field.ladders.map((l) =>
                l.table ? (
                  <table class="mech-table">
                    {l.caption && <caption>{l.caption}</caption>}
                    <thead>
                      <tr>{l.table.columns.map((c) => <th>{mechanicLabelEs(c)}</th>)}</tr>
                    </thead>
                    <tbody>
                      {l.table.rows.map((row) => (
                        <tr>{l.table!.columns.map((c) => <td>{cell(row[c])}</td>)}</tr>
                      ))}
                    </tbody>
                  </table>
                ) : (
                  <>
                    {l.caption && <p class="scale-name">{l.caption}</p>}
                    <p class="scale-formula">{l.formula}</p>
                  </>
                )
              )}
            {field.arrayValue &&
              (Array.isArray(field.html)
                ? field.html.map((h, i) => (
                    <>
                      {i > 0 && ', '}
                      <Fragment set:html={h} />
                    </>
                  ))
                : field.arrayValue.map(cell).join(', '))}
            {field.objectValue && (
              <ul class="obj-list">
                {field.objectValue.map(([k, v]) => (
                  <li>
                    <strong>{mechanicLabelEs(k)}:</strong> {cell(v)}
                  </li>
                ))}
              </ul>
            )}
            {field.textValue &&
              (typeof field.html === 'string' ? <Fragment set:html={field.html} /> : field.textValue)}
          </dd>
        </>
      ))}
    </dl>
  )
}

<style>
  /* Stacked label/value: the value always gets the full width, so long lists
     and comma-strings wrap naturally instead of being crammed into a narrow
     column (works in both the narrow card and the wider detail page). */
  .stat-block {
    display: block;
    margin: 0;
    max-width: var(--measure);
  }
  .stat-block dt {
    font-weight: 700;
    color: var(--muted);
    font-size: 0.8em;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.5em;
  }
  .stat-block dt:first-child {
    margin-top: 0;
  }
  .stat-block dd {
    margin: 0.1em 0 0;
  }
  .spheres {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15em;
  }
  .mech-table {
    border-collapse: collapse;
    margin: 0.25em 0;
    font-size: 0.95em;
  }
  .mech-table th,
  .mech-table td {
    border: 1px solid var(--border, #ccc);
    padding: 0.2em 0.5em;
    text-align: left;
    vertical-align: top;
  }
  .mech-table th {
    color: var(--muted);
    font-weight: 700;
  }
  /* The axis name of a multi-scale trait. A <caption> rather than a heading: it names THIS table
     for a screen reader without inventing a heading level, and StatBlock renders inside both a
     card and a detail page. */
  .mech-table caption {
    caption-side: top;
    text-align: left;
    font-weight: 700;
    padding: 0.15em 0;
  }
  /* A FORMULA axis: the book states it as a sentence and prints no rungs, so there is no table to
     caption. The name is carried by a paragraph styled like the table caption above, and the
     sentence sits under it. Two classes, and NEITHER is a prefix of the other — `wod-kb-scale`
     being a prefix of a would-be `wod-kb-scale-note` is exactly what made the Python renderer pick
     `wod-kb-formula`, because the coverage guard counts headings by substring. Keep it that way:
     any counter over this markup must be able to tell a drawn ladder from a stated formula. */
  .scale-name {
    margin: 0.25em 0 0;
    font-weight: 700;
  }
  .scale-formula {
    margin: 0.1em 0 0;
    max-width: var(--measure);
  }
  /* How the points are divided across those axes — a rule the tables cannot state themselves. */
  .alloc-note {
    margin: 0.25em 0 0;
    color: var(--muted);
    font-size: 0.95em;
  }
  .obj-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15em;
  }
</style>
