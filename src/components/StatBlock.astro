---
// Renders an entity's `mechanics` as a labelled definition list, in the
// field order declared for its type (webgen/taxonomy.json), with Spanish
// labels. Rating-like fields render as dot pips; sphere maps render one
// dot-rating per sphere; everything else renders as plain text.
import DotRating from './DotRating.astro';
import { mechanicLabelEs, sphereLabelEs, TYPE_INFO } from '../lib/taxonomy';
import { allocationNoteEs, axisFieldKey, ratedAxes } from '../lib/ratedAxes';

export interface Props {
  type: string;
  mechanics: Record<string, unknown>;
  // Pre-rendered HTML (with deep-links) for string/list mechanics values; keyed
  // by mechanic. Present only where an entity link was injected.
  mechanicsHtml?: Record<string, string | string[]>;
}
const { type, mechanics, mechanicsHtml = {} } = Astro.props;

// Fields rendered as dot ratings when their value is a plain number.
const DOT_FIELDS = new Set([
  'cost',
  'bonus',
  'rating_max',
  'arete_min',
  'arete',
  'quintessence',
  'level',
  'rank',
]);

function toSphereEntries(value: unknown): Array<[string, number]> {
  if (!value || typeof value !== 'object' || Array.isArray(value)) return [];
  return Object.entries(value as Record<string, number>);
}

const knownFields = TYPE_INFO[type]?.mechanical_fields ?? [];
// Show declared fields plus any extra keys, but hide internal `_`-prefixed
// extraction-metadata keys (e.g. `_extraction_note`) — not player-facing.
const extraFields = Object.keys(mechanics).filter(
  (key) => !knownFields.includes(key) && !key.startsWith('_')
);
const fieldKeys = [...knownFields, ...extraFields].filter(
  (key) => mechanics[key] !== undefined && mechanics[key] !== null
);

const cell = (v: unknown): string =>
  v === null || v === undefined ? '' : typeof v === 'object' ? JSON.stringify(v) : String(v);

function isObjectArray(v: unknown): v is Array<Record<string, unknown>> {
  return (
    Array.isArray(v) &&
    v.length > 0 &&
    v.every((x) => x !== null && typeof x === 'object' && !Array.isArray(x))
  );
}

// One rendered table. `caption` is '' for every table the site emitted before `mechanics.scales`
// existed (an extracted rules table, and the single unnamed ladder of a `mechanics.ratings`
// carrier); it carries the axis name only for a multi-scale trait, where three anonymous tables
// would be unreadable.
interface MechTable {
  caption: string;
  rows: Array<Record<string, unknown>>;
  columns: string[];
}

interface Field {
  key: string;
  label: string;
  sphereEntries: Array<[string, number]>;
  numericValue?: number;
  tables?: MechTable[]; // array-of-objects → one table; a multi-scale trait → one per axis
  note?: string; // how points are spent across a multi-scale trait's axes
  arrayValue?: unknown[]; // array of primitives → comma list
  objectValue?: Array<[string, unknown]>; // single object → key/value list
  textValue?: string;
  html?: string | string[]; // pre-rendered HTML (deep-links) for text/array values
}

const withColumns = (caption: string, rows: Array<Record<string, unknown>>): MechTable => ({
  caption,
  rows,
  columns: [...new Set(rows.flatMap((r) => Object.keys(r)))],
});

// The entity's rated axes, resolved ONCE through the shared definition rather than re-derived per
// field. A `mechanics.ratings` carrier yields the single degenerate axis (empty `name_es` → no
// caption, no note), so its markup is exactly what it was before `scales` existed; a
// `mechanics.scales` carrier yields one named axis per scale.
const axes = ratedAxes(mechanics);
const ladderKey = axisFieldKey(mechanics);
const ladderTables: MechTable[] = axes
  .filter((axis) => isObjectArray(axis.ratings))
  .map((axis) => withColumns(axis.name_es, axis.ratings as Array<Record<string, unknown>>));
const ladderNote = ladderKey === 'scales' ? allocationNoteEs(axes, mechanics.rating_max as number | undefined) : '';

const fields: Field[] = fieldKeys.map((key) => {
  const value = mechanics[key];
  // Only treat `spheres` as a dot-pip map when it's actually an object
  // ({Vida: 3}). Lane-B often writes it as a free-text string ("Correspondencia
  // ·· / Fuerzas ·· / Mente ··"); those must fall through to textValue, else the
  // Esferas field renders blank.
  const sphereEntries = key === 'spheres' ? toSphereEntries(value) : [];
  const isSphereMap = sphereEntries.length > 0;
  const numericValue = !isSphereMap && DOT_FIELDS.has(key) && typeof value === 'number' ? value : undefined;
  // The rating ladder(s). One table for a `ratings` carrier — the same markup, from the same
  // renderer, as before — and one captioned table per axis for a `scales` carrier, whose value is
  // an array of SCALE objects and would otherwise land in the generic branch below as a table of
  // `key | name_es | rating_max | allocation | ratings` with five rung objects JSON-stringified
  // into one cell.
  const isLadder = key === ladderKey && ladderTables.length > 0;
  // Array of objects (e.g. an extracted rules table) → render as a real table,
  // never `[object Object]`. Columns are the union of keys across rows.
  const generic = !isLadder && !isSphereMap && numericValue === undefined && isObjectArray(value) ? value : undefined;
  const tables = isLadder ? ladderTables : generic ? [withColumns('', generic)] : undefined;
  const note = isLadder && ladderNote ? ladderNote : undefined;
  const arrayValue =
    !isSphereMap && numericValue === undefined && !tables && Array.isArray(value) ? value : undefined;
  const objectValue =
    !isSphereMap && numericValue === undefined && !tables && !arrayValue && value && typeof value === 'object'
      ? Object.entries(value as Record<string, unknown>)
      : undefined;
  const textValue =
    !isSphereMap && numericValue === undefined && !tables && !arrayValue && !objectValue
      ? String(value)
      : undefined;
  const html = mechanicsHtml[key]; // pre-rendered HTML with deep-links, if any
  return { key, label: mechanicLabelEs(key), sphereEntries, numericValue, tables, note, arrayValue, objectValue, textValue, html };
});
---

{
  fields.length > 0 && (
    <dl class="stat-block">
      {fields.map((field) => (
        <>
          <dt>{field.label}</dt>
          <dd>
            {field.sphereEntries.length > 0 && (
              <ul class="spheres">
                {field.sphereEntries.map(([sphere, dots]) => (
                  <li>
                    {sphereLabelEs(sphere)} <DotRating value={dots} label={sphereLabelEs(sphere)} />
                  </li>
                ))}
              </ul>
            )}
            {field.numericValue !== undefined && (
              <DotRating value={field.numericValue} label={field.label} />
            )}
            {field.note && <p class="alloc-note">{field.note}</p>}
            {field.tables &&
              field.tables.map((t) => (
                <table class="mech-table">
                  {t.caption && <caption>{t.caption}</caption>}
                  <thead>
                    <tr>{t.columns.map((c) => <th>{mechanicLabelEs(c)}</th>)}</tr>
                  </thead>
                  <tbody>
                    {t.rows.map((row) => (
                      <tr>{t.columns.map((c) => <td>{cell(row[c])}</td>)}</tr>
                    ))}
                  </tbody>
                </table>
              ))}
            {field.arrayValue &&
              (Array.isArray(field.html)
                ? field.html.map((h, i) => (
                    <>
                      {i > 0 && ', '}
                      <Fragment set:html={h} />
                    </>
                  ))
                : field.arrayValue.map(cell).join(', '))}
            {field.objectValue && (
              <ul class="obj-list">
                {field.objectValue.map(([k, v]) => (
                  <li>
                    <strong>{mechanicLabelEs(k)}:</strong> {cell(v)}
                  </li>
                ))}
              </ul>
            )}
            {field.textValue &&
              (typeof field.html === 'string' ? <Fragment set:html={field.html} /> : field.textValue)}
          </dd>
        </>
      ))}
    </dl>
  )
}

<style>
  /* Stacked label/value: the value always gets the full width, so long lists
     and comma-strings wrap naturally instead of being crammed into a narrow
     column (works in both the narrow card and the wider detail page). */
  .stat-block {
    display: block;
    margin: 0;
    max-width: var(--measure);
  }
  .stat-block dt {
    font-weight: 700;
    color: var(--muted);
    font-size: 0.8em;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.5em;
  }
  .stat-block dt:first-child {
    margin-top: 0;
  }
  .stat-block dd {
    margin: 0.1em 0 0;
  }
  .spheres {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15em;
  }
  .mech-table {
    border-collapse: collapse;
    margin: 0.25em 0;
    font-size: 0.95em;
  }
  .mech-table th,
  .mech-table td {
    border: 1px solid var(--border, #ccc);
    padding: 0.2em 0.5em;
    text-align: left;
    vertical-align: top;
  }
  .mech-table th {
    color: var(--muted);
    font-weight: 700;
  }
  /* The axis name of a multi-scale trait. A <caption> rather than a heading: it names THIS table
     for a screen reader without inventing a heading level, and StatBlock renders inside both a
     card and a detail page. */
  .mech-table caption {
    caption-side: top;
    text-align: left;
    font-weight: 700;
    padding: 0.15em 0;
  }
  /* How the points are divided across those axes — a rule the tables cannot state themselves. */
  .alloc-note {
    margin: 0.25em 0 0;
    color: var(--muted);
    font-size: 0.95em;
  }
  .obj-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15em;
  }
</style>
